# Campus Quest 本機開發環境變數
# 複製成 .env 後填入。.env 已經在 .gitignore 裡，不會被提交。

# ---------------------------------------------------------------
# 資料庫（MySQL 8 / MariaDB）
# ---------------------------------------------------------------
# 不填也能啟動：getDb() 會回傳 null，只有雲端同步與附件功能不能用。
# 成績、課程規劃、專題、證照本來就存在瀏覽器 localStorage，不受影響。
DATABASE_URL=mysql://campus:campus@localhost:3306/campus_quest

# ---------------------------------------------------------------
# 本機開發登入繞過
# ---------------------------------------------------------------
# 設為 1 時，所有請求都以擁有者（admin）身分執行，不需要 Manus OAuth。
# 只在 NODE_ENV !== production 時生效。
# 正式部署絕對不要設定這一項。
LOCAL_DEV_OWNER=1
LOCAL_DEV_NAME=本機開發者
LOCAL_DEV_EMAIL=dev@localhost

# ---------------------------------------------------------------
# 以下都是 Manus 專屬服務，脫離 Manus 後留空即可
# ---------------------------------------------------------------

# Manus OAuth。自架不了，改用 LOCAL_DEV_OWNER 或自己接一套登入。
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# Manus Forge API。影響：AI 選課建議、PDF 成績單轉換、成就附件上傳與代理。
# 留空時這些功能會回傳設定缺失錯誤，其餘功能正常。
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Session cookie 簽章金鑰。改用自己的登入機制時才需要。
# 產生方式：openssl rand -base64 32
JWT_SECRET=
